<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Malfunctions</AssemblyName>
    <RootNamespace>Malfunctions</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);IDE0051</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Game install to compile against and deploy into. Override with -p:LethalCompanyDir=... or the env var of the same name. -->
  <PropertyGroup>
    <LethalCompanyDir Condition="'$(LethalCompanyDir)' == '' And '$(OS)' == 'Windows_NT'">E:\Windows\Lethal Company IDE</LethalCompanyDir>
    <LethalCompanyDir Condition="'$(LethalCompanyDir)' == ''">/mnt/Storage/Windows/Lethal Company IDE</LethalCompanyDir>
    <ManagedDir>$(LethalCompanyDir)/Lethal Company_Data/Managed</ManagedDir>
    <BepInExDir>$(LethalCompanyDir)/BepInEx</BepInExDir>
    <DeployDir>$(BepInExDir)/plugins/zealsprince-$(AssemblyName)</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(ManagedDir)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="ClientNetworkTransform" HintPath="$(ManagedDir)/ClientNetworkTransform.dll" Private="false" />
    <Reference Include="DissonanceVoip" HintPath="$(ManagedDir)/DissonanceVoip.dll" Private="false" />
    <Reference Include="Facepunch Transport for Netcode for GameObjects" HintPath="$(ManagedDir)/Facepunch Transport for Netcode for GameObjects.dll" Private="false" />
    <Reference Include="Facepunch.Steamworks.Win64" HintPath="$(ManagedDir)/Facepunch.Steamworks.Win64.dll" Private="false" />
    <Reference Include="Unity.AI.Navigation" HintPath="$(ManagedDir)/Unity.AI.Navigation.dll" Private="false" />
    <Reference Include="Unity.Animation.Rigging" HintPath="$(ManagedDir)/Unity.Animation.Rigging.dll" Private="false" />
    <Reference Include="Unity.Collections" HintPath="$(ManagedDir)/Unity.Collections.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.Netcode.Components" HintPath="$(ManagedDir)/Unity.Netcode.Components.dll" Private="false" />
    <Reference Include="Unity.Netcode.Runtime" HintPath="$(ManagedDir)/Unity.Netcode.Runtime.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime" HintPath="$(ManagedDir)/Unity.RenderPipelines.HighDefinition.Runtime.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDir)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ManagedDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.VFXModule" HintPath="$(ManagedDir)/UnityEngine.VFXModule.dll" Private="false" />
    <Reference Include="UnityEngine.VideoModule" HintPath="$(ManagedDir)/UnityEngine.VideoModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/core/0Harmony.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)/core/BepInEx.dll" Private="false" />
    <Reference Include="OdinSerializer" HintPath="$(BepInExDir)/plugins/Odin Serializer/OdinSerializer.dll" Private="false" />
    <Reference Include="LethalNetworkAPI" HintPath="$(BepInExDir)/plugins/LethalNetworkAPI/LethalNetworkAPI.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(LethalCompanyDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
  </Target>
</Project>
